<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>DSH</string>
	<key>CFBundleIconName</key>
	<string>app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The Platform sign-in completion page returns the user to the desktop
	     shell by opening `dsh://open`, so the shell has to claim the scheme the
	     official Desktop also registers. Launch Services keeps one handler per
	     scheme: whichever bundle it saw last wins, and the URL is only an
	     opener — it carries no credential and none is read from it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).dsh</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dsh</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- One instance per user session: LaunchServices stops a same-bundle second
	     launch before our own flock check runs (which still covers other builds
	     and open -n). See Sources/Service/DshInstanceLock.swift. -->
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>DSH 语音输入需要使用麦克风，将您的语音转换为文本。</string>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License</string>
	<key>NSMainNibFile</key>
	<string></string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/summer-521/deepseek-harness-swift/main/appcast-swift.xml</string>
	<key>SUPublicEDKey</key>
	<string>cJQCfMWONqsv4dEXCrnfcVDGHCnlNsd77Xa4BHF9d5M=</string>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
</dict>
</plist>
